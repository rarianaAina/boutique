{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MOBI STOCK",
  "version": "0.1.0",
  "identifier": "com.boutique.gestion",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MOBI STOCK",
        "width": 1400,
        "height": 880,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "copyright": "© 2026",
    "category": "Business",
    "shortDescription": "MOBI STOCK — gestion de boutique hors ligne",
    "longDescription": "Gestion de boutiques de smartphones, accessoires et matériel informatique : stock par IMEI, caisse, achats, transferts inter-boutiques et synchronisation à la demande.",
    "publisher": "MOBI STOCK",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": ["French"],
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
