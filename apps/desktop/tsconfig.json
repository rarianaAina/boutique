{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noEmit": true,
    // Les tests de synchronisation importent le serveur, dont les modules se
    // référencent avec l'extension .ts (il tourne sous Node en TypeScript natif).
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "tests", "vite.config.ts"],
  "exclude": ["src-tauri", "dist"]
}
